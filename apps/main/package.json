{
  "name": "main",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint --cache --cache-location ../../.cache/eslint/main --cache-strategy content .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/main --cache-strategy content . --fix",
    "start": "vite preview",
    "typecheck": "tsc --tsBuildInfoFile ../../.cache/typecheck/apps-main.tsbuildinfo",
    "commit": "commit",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable"
  },
  "dependencies": {
    "@curvefi/evm-ui": "workspace:^",
    "@curvefi/legacy-ui": "workspace:^",
    "@curvefi/ui": "workspace:^",
    "fuse.js": "7.5.0",
    "merkl-api": "workspace:^",
    "router-api": "workspace:^",
    "vest": "5.4.6",
    "vite-plugin-vercel": "9.1.1"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "5.4.0",
    "@types/lodash": "4.17.24",
    "@vitejs/plugin-react": "5.1.2",
    "pinst": "3.0.0"
  }
}
