{
  "name": "stellar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy-cf": "node ../../.github/scripts/wait-for-ci.ts stellar && wrangler deploy",
    "lint": "eslint --cache --cache-location ../../.cache/eslint/stellar --cache-strategy content .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/stellar --cache-strategy content . --fix",
    "start": "vite preview",
    "typecheck": "tsc --tsBuildInfoFile ../../.cache/typecheck/apps-stellar.tsbuildinfo"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "2.7.1",
    "@curvefi/api-server": "workspace:^",
    "@curvefi/ui": "workspace:^",
    "@stellar/stellar-sdk": "17.4.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-query-devtools": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-core": "1.171.39",
    "merkl-api": "workspace:^",
    "vite-plugin-svgr": "5.2.0",
    "vite-plugin-vercel": "11.2.0",
    "wrangler": "4.154.0"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "11.9.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5"
  }
}
