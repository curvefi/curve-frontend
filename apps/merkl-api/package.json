{
  "name": "merkl-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "lint": "eslint --cache --cache-location ../../.cache/eslint/merkl-api --cache-strategy content --ignore-pattern '**/*.stories.{ts,tsx,mts}' .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/merkl-api --cache-strategy content --ignore-pattern '**/*.stories.{ts,tsx,mts}' . --fix",
    "typecheck": "tsc --tsBuildInfoFile ../../.cache/typecheck/apps-merkl-api.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@curvefi/api-server": "workspace:^",
    "fastify": "5.12.1"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "tsx": "4.23.12"
  }
}
