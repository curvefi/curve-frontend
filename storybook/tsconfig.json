{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@/*": ["../apps/main/src/*"],
      "@legacy-ui": ["../packages/legacy-ui/src/index.ts"],
      "@legacy-ui/*": ["../packages/legacy-ui/src/*"],
      "@evm-ui/*": ["../packages/evm-ui/src/*"],
      "@ui": ["../packages/ui/src/index.ts"],
      "@ui/*": ["../packages/ui/src/*"],
      "@external-rewards": ["../packages/external-rewards/src/index.ts"],
      "@curvefi/prices-api": ["../packages/prices-api/src/index.ts"],
      "@curvefi/prices-api/*": ["../packages/prices-api/src/*"],
      "@primitives/*": ["../packages/primitives/src/*"],
      "@/stellar/*": ["../apps/stellar/src/*"]
    },
    "tsBuildInfoFile": "../.cache/typecheck/storybook.tsbuildinfo"
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "vite.config.ts",
    "stories/**/*.ts",
    "stories/**/*.tsx",
    "../apps/**/*.stories.*",
    "../packages/**/*.stories.*",
    "../packages/**/*.d.ts"
  ],
  "exclude": ["node_modules", "storybook-static"],
  "references": [
    { "path": "../packages/primitives/tsconfig.typecheck.json" },
    { "path": "../packages/prices-api/tsconfig.typecheck.json" },
    { "path": "../packages/ui" },
    { "path": "../packages/evm-ui" },
    { "path": "../packages/external-rewards" },
    { "path": "../packages/api-server" },
    { "path": "../apps/merkl-api" },
    { "path": "../apps/router-api" },
    { "path": "../apps/main" },
    { "path": "../apps/stellar" }
  ]
}
