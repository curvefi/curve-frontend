{
  "name": "tests",
  "version": "0.1.0",
  "description": "Curve DApp tests",
  "license": "MIT",
  "main": "index.js",
  "installConfig": {
    "hoistingLimits": "dependencies"
  },
  "scripts": {
    "lint": "eslint --cache --cache-location ../.cache/eslint/tests --cache-strategy content .",
    "lint:fix": "eslint --cache --cache-location ../.cache/eslint/tests --cache-strategy content . --fix",
    "typecheck": "tsc --tsBuildInfoFile ../.cache/typecheck/tests.tsbuildinfo",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "vitest:watch": "vitest --watch",
    "cy": "cypress",
    "cy:open:e2e": "cypress open --e2e",
    "cy:run:e2e": "wait-on http://localhost:3000 --timeout 1m && cypress run --e2e",
    "cy:open:component": "cypress open --component",
    "cy:run:component": "cypress run --component --spec 'cypress/component/**/!(*.rpc).cy.{ts,tsx}'",
    "cy:run:rpc": "cypress run --component --spec 'cypress/component/**/*.rpc.cy.{ts,tsx}'",
    "download:artifacts": "node --experimental-strip-types scripts/download-artifacts.ts"
  },
  "devDependencies": {
    "@curvefi/llamalend-api": "2.5.2",
    "@curvefi/prices-api": "3.1.1",
    "@curvefi/primitives": "0.0.1",
    "@cypress/react": "9.0.2",
    "@cypress/vite-dev-server": "7.3.4",
    "@mui/material": "9.3.1",
    "@tanstack/react-query": "5.102.7",
    "@tanstack/react-query-devtools": "5.102.7",
    "@tanstack/react-router": "1.170.32",
    "@types/lodash": "4.17.24",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/ui": "4.1.10",
    "@wagmi/core": "3.6.4",
    "bignumber.js": "9.3.1",
    "cypress": "15.19.0",
    "eslint": "10.8.0",
    "ethers": "6.17.0",
    "evm-ui": "0.1.0",
    "legacy-ui": "0.0.0",
    "lodash": "4.18.1",
    "main": "3.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "viem": "2.55.10",
    "vite": "7.3.5",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "4.1.10",
    "wagmi": "3.7.4",
    "wait-on": "9.1.0"
  }
}
