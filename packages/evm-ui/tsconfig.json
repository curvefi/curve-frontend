{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@legacy-ui": ["../legacy-ui/src/index.ts"],
      "@legacy-ui/*": ["../legacy-ui/src/*"],
      "@evm-ui/*": ["./src/*"],
      "@ui": ["../ui/src/index.ts"],
      "@ui/*": ["../ui/src/*"],
      "@external-rewards": ["../external-rewards/src/index.ts"],
      "@external-rewards/*": ["../external-rewards/src/*"],
      "@curvefi/prices-api": ["../prices-api/src/index.ts"],
      "@curvefi/prices-api/*": ["../prices-api/src/*"],
      "@primitives/*": ["../primitives/src/*"]
    },
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": "..",
    "outDir": "../../.cache/typecheck/evm-ui",
    "tsBuildInfoFile": "../../.cache/typecheck/evm-ui.tsbuildinfo"
  },
  "include": ["src", "../legacy-ui/src", "../ui/src/**/*.d.ts"],
  "references": [
    { "path": "../primitives/tsconfig.typecheck.json" },
    { "path": "../prices-api/tsconfig.typecheck.json" },
    { "path": "../ui" },
    { "path": "../external-rewards" }
  ]
}
