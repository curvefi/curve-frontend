{
  "name": "@curvefi/api-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint --cache --cache-location ../../.cache/eslint/api-server --cache-strategy content --ignore-pattern '**/*.stories.{ts,tsx,mts}' .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/api-server --cache-strategy content --ignore-pattern '**/*.stories.{ts,tsx,mts}' . --fix",
    "typecheck": "tsc --tsBuildInfoFile ../../.cache/typecheck/packages-api-server.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "dependencies": {
    "fastify": "5.12.1"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
