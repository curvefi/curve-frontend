{
  "name": "@curvefi/primitives",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "yarn run --top-level test --project @curvefi/primitives",
    "test:ui": "yarn run --top-level test:ui --project @curvefi/primitives",
    "vitest:watch": "yarn run --top-level test:watch --project @curvefi/primitives",
    "lint": "eslint --cache --cache-location ../../.cache/eslint/primitives --cache-strategy content .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/primitives --cache-strategy content . --fix",
    "typecheck": "tsc --noEmit --tsBuildInfoFile ../../.cache/typecheck/packages-primitives.tsbuildinfo"
  },
  "devDependencies": {
    "@vitest/ui": "5.0.2",
    "vitest": "5.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ]
}
