{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@legacy-ui": ["./src/index.tsx"],
      "@legacy-ui/*": ["./src/*"],
      "@external-rewards": ["../external-rewards/src/index.ts"],
      "@curvefi/prices-api": ["../prices-api/src/index.ts"],
      "@curvefi/prices-api/*": ["../prices-api/src/*"],
      "@primitives/*": ["../primitives/src/*"],
      "@evm-ui/*": ["../evm-ui/src/*"],
      "@ui": ["../ui/src/index.ts"],
      "@ui/*": ["../ui/src/*"]
    }
  },
  "include": ["src", "../evm-ui/**/*.d.ts", "../ui/src/**/*.d.ts"]
}
