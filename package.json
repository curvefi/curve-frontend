{
  "name": "@curvefi/curve-frontend",
  "version": "2.1.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests",
    "storybook"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --parallel --all run build",
    "test": "yarn workspace @curvefi/primitives exec \"cd ../.. && vitest run\"",
    "test:watch": "yarn workspace @curvefi/primitives exec \"cd ../.. && vitest --watch\"",
    "test:ui": "yarn workspace @curvefi/primitives exec \"cd ../.. && vitest --ui\"",
    "start": "yarn workspace main start",
    "dev": "yarn workspace main dev",
    "dev-router-api": "yarn workspace router-api dev",
    "dev-merkl-api": "yarn workspace merkl-api dev",
    "lint": "yarn workspaces foreach --parallel --all --exclude curve-frontend run lint",
    "lint:fix": "yarn workspaces foreach --parallel --all --exclude curve-frontend run lint:fix",
    "typecheck": "node -e \"require('fs').mkdirSync('.cache/typecheck', {recursive: true})\" && yarn workspaces foreach --parallel --all run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "storybook": "yarn workspace @curvefi/storybook storybook",
    "storybook:build": "yarn workspace @curvefi/storybook build:storybook",
    "check-supply-chain": "node .github/check-supply-chain.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint-react/eslint-plugin": "5.27.4",
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@tanstack/eslint-plugin-query": "5.104.2",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-storybook": "10.6.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "rolldown": "1.2.14",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.71.1",
    "vite-plugin-svgr": "5.2.0"
  },
  "packageManager": "yarn@4.18.1",
  "lint-staged": {
    "{apps,tests,packages,storybook}/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "resolutions": {
    "@types/node": "26.6.5"
  }
}
